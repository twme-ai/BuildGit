{
  "schemaVersion": 1,
  "id": "buildgit",
  "version": "${version}",
  "name": "BuildGit",
  "description": "給建築伺服器的版本控制：只記玩家造成的變更，像 git 一樣存檔、比較與還原。",
  "authors": ["twme"],
  "contact": { "homepage": "https://twme.dev" },
  "environment": "*",
  "entrypoints": {
    "main": ["dev.twme.buildgit.fabric.BuildGitMod"]
  },
  "mixins": ["buildgit.mixins.json", "buildgit.version.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
