{
  "schemaVersion": 1,
  "id": "buildgit",
  "version": "${version}",
  "name": "BuildGit",
  "description": "Version control for build servers: records only the changes players make, and saves, compares and restores them like git.",
  "license": "MIT",
  "authors": ["twme"],
  "contact": { "homepage": "https://twme.dev" },
  "environment": "*",
  "entrypoints": {
    "main": ["dev.twme.buildgit.fabric.BuildGitMod"],
    "client": ["dev.twme.buildgit.fabric.client.BuildGitClient"]
  },
  "mixins": ["buildgit.mixins.json", "buildgit.version.mixins.json", "buildgit.axiom.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
